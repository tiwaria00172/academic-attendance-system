# Production Environment Variables Example
# Copy this file to .env on your production server and fill in secure values

# ─── Flask Server & Security ─────────────────────────────────────────────
FLASK_ENV=production
FLASK_APP=backend/run.py
SECRET_KEY=replace-with-a-64-character-random-hex-string-for-jwt-security
JWT_ACCESS_TOKEN_EXPIRES=86400

# ─── Database Connection ─────────────────────────────────────────────────
# Example PostgreSQL Connection String (Use strong passwords in production)
SQLALCHEMY_DATABASE_URI=postgresql://attendance_admin:secure_password_here@db:5432/attendance_prod_db
# For SQLite fallback (not recommended for >5 simultaneous users):
# SQLALCHEMY_DATABASE_URI=sqlite:///instance/attendance_prod.db

# ─── AI Engine & Caching Paths ───────────────────────────────────────────
TRAINING_DATA_DIR=/app/data/training
TESTING_DATA_DIR=/app/data/testing
RESULTS_DIR=/app/results
CACHE_FILE_PATH=/app/data/student_encodings_cache.npz

# ─── Face Recognition Tuning ─────────────────────────────────────────────
# 'hog' (fast CPU baseline, ~20ms) or 'cnn' (NVIDIA GPU required, ~5ms)
FACE_DETECTION_MODEL=hog

# Confidence thresholds (0.0 to 1.0 similarity)
FACE_CONFIDENCE_AUTO=0.45
FACE_CONFIDENCE_MANUAL=0.30
FACE_AMBIGUITY_THRESHOLD=0.03

# Batch and multi-scale settings
BATCH_SIZE=32
UPSAMPLE_TRAINING=2
UPSAMPLE_CLASSROOM=1
UPSAMPLE_MAX=3
